# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
DOMAIN=localhost
DATA_DIR=./data

POSTGRES_DB=dayly
POSTGRES_PASSWORD=change-me-owner
DAYLY_APP_PASSWORD=change-me-app
DATABASE_OWNER_URL=postgres://dayly_owner:change-me-owner@postgres:5432/dayly
DATABASE_APP_URL=postgres://dayly_app:change-me-app@postgres:5432/dayly

SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:5173

# Backups (age public key; private key is never stored on the VM)
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
DAYLY_OWNER_PASSWORD=local-owner-placeholder
DAYLY_APP_PASSWORD=local-app-placeholder
DATABASE_URL=postgresql://dayly_app:local-app-placeholder@postgres:5432/dayly
MIGRATION_DATABASE_URL=postgresql://dayly_owner:local-owner-placeholder@postgres:5432/dayly
APP_VERSION=0.0.1
PORT=3000
HOST=0.0.0.0
